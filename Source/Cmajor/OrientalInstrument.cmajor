/*
    ORIENTAL INSTRUMENT — Cmajor port (v1-mono) for Amorph.

    Single-processor, monophonic (last-note priority). Matches Amorph's
    proven template shape: one processor, raw MIDI in, audio out, [[ ]]
    parameter annotations. No graph / VoiceAllocator yet (v2 = polyphony).

    Signal chain (mirrors Source/DSP/OrientalVoice.cpp):
        3-osc unison + sub + white noise
          -> ADAA antialiased waveshaper (asym soft saturation)
          -> TPT state-variable lowpass (resonant)
          -> 2 parallel formant bandpass (Oud body resonance)
          -> ADSR amp + final tanh

    Amorph expects a top-level `processor` (or graph/namespace). No bare `{ }`
    block scopes inside functions — Cmajor doesn't allow them.

    Press COMPILE in Amorph; report errors to iterate.
*/

processor OrientalInstrument
{
    input event std::midi::Message midiIn;
    output stream float out;

    // ── Macro parameters (no trailing comma before ]] — Amorph syntax) ──
    input event float driveParam   [[ name: "Drive",     min: 1.0,   max: 4.0,     init: 1.8 ]];
    input event float asymParam    [[ name: "Asym",      min: 0.0,   max: 0.4,     init: 0.22 ]];
    input event float subParam     [[ name: "Sub",       min: 0.0,   max: 1.0,     init: 0.18 ]];
    input event float noiseParam   [[ name: "Noise",     min: 0.0,   max: 1.0,     init: 0.20 ]];
    input event float detuneParam  [[ name: "Detune",    min: 0.0,   max: 20.0,    init: 4.0 ]];
    input event float cutoffParam  [[ name: "Cutoff",    min: 100.0, max: 12000.0, init: 3000.0 ]];
    input event float resoParam    [[ name: "Resonance", min: 0.5,   max: 8.0,     init: 1.6 ]];
    input event float waveParam    [[ name: "Wave",      min: 0.0,   max: 3.0,     init: 1.0 ]];
    input event float attackParam  [[ name: "Attack",    min: 0.001, max: 2.0,     init: 0.004 ]];
    input event float decayParam   [[ name: "Decay",     min: 0.01,  max: 3.0,     init: 0.45 ]];
    input event float sustainParam [[ name: "Sustain",   min: 0.0,   max: 1.0,     init: 0.30 ]];
    input event float releaseParam [[ name: "Release",   min: 0.01,  max: 4.0,     init: 0.80 ]];

    // ── Parameter state ──
    float drive = 1.8f, asym = 0.22f, subLevel = 0.18f, noiseAmt = 0.20f,
          detuneCents = 4.0f, cutoffHz = 3000.0f, reso = 1.6f;
    int   waveType = 1;
    float attackS = 0.004f, decayS = 0.45f, sustainLvl = 0.30f, releaseS = 0.80f;

    event driveParam   (float v) { drive = v; }
    event asymParam    (float v) { asym = v; }
    event subParam     (float v) { subLevel = v; }
    event noiseParam   (float v) { noiseAmt = v; }
    event detuneParam  (float v) { detuneCents = v; }
    event cutoffParam  (float v) { cutoffHz = v; }
    event resoParam    (float v) { reso = v; }
    event waveParam    (float v) { waveType = int (v + 0.5f); }
    event attackParam  (float v) { attackS = v; }
    event decayParam   (float v) { decayS = v; }
    event sustainParam (float v) { sustainLvl = v; }
    event releaseParam (float v) { releaseS = v; }

    // ── MIDI decode (mono, last-note priority) ──
    int   currentNote = -1;
    float noteFreq = 440.0f;
    float velocity = 0.0f;

    event midiIn (std::midi::Message m)
    {
        let packed = m.message;
        let status = (packed >> 16) & 0xf0;
        let data1  = (packed >> 8)  & 0x7f;
        let data2  =  packed        & 0x7f;

        if (status == 0x90 && data2 > 0)          // note on
        {
            currentNote = data1;
            noteFreq = float (440.0 * pow (2.0, (float (data1) - 69.0) / 12.0));
            velocity = float (data2) / 127.0f;
            startNote();
        }
        else if (status == 0x80 || (status == 0x90 && data2 == 0)) // note off
        {
            if (data1 == currentNote)
                envStage = 4;                      // release
        }
    }

    // ── Envelope (0 idle, 1 attack, 2 decay, 3 sustain, 4 release) ──
    int   envStage = 0;
    float envLevel = 0.0f;

    // ── Oscillator phases ──
    float ph0 = 0.0f, ph1 = 0.0f, ph2 = 0.0f, phSub = 0.0f;

    // ── ADAA waveshaper memory ──
    float adaaX1 = 0.0f, adaaF1 = 0.0f;

    // ── Noise one-pole + xorshift RNG ──
    float noiseLP = 0.0f;
    int64 rngState = 0x2545F4914F6CDD1Di64;

    // ── TPT SVF state ──
    float svfIc1 = 0.0f, svfIc2 = 0.0f;

    // ── Two formant biquad states (Direct Form I) ──
    float f1x1 = 0.0f, f1x2 = 0.0f, f1y1 = 0.0f, f1y2 = 0.0f;
    float f2x1 = 0.0f, f2x2 = 0.0f, f2y1 = 0.0f, f2y2 = 0.0f;

    let twoPi = 6.28318530717959f;

    void startNote()
    {
        envStage = 1;
        ph0 = 0.0f; ph1 = 0.33f; ph2 = 0.66f; phSub = 0.0f;
        adaaX1 = 0.0f; adaaF1 = 0.0f;
        noiseLP = 0.0f;
        svfIc1 = 0.0f; svfIc2 = 0.0f;
        f1x1 = 0.0f; f1x2 = 0.0f; f1y1 = 0.0f; f1y2 = 0.0f;
        f2x1 = 0.0f; f2x2 = 0.0f; f2y1 = 0.0f; f2y2 = 0.0f;
    }

    // ── Waveshaper + antiderivative (ADAA) ──
    float shape (float x)          { return tanh (x + asym) - tanh (asym); }
    float shapeAntideriv (float x) { return log (cosh (x + asym)) - tanh (asym) * x; }

    float adaaShape (float x)
    {
        let f  = shapeAntideriv (x);
        let dx = x - adaaX1;
        float y;
        if (abs (dx) > 1.0e-4f)
            y = (f - adaaF1) / dx;
        else
            y = shape (0.5f * (x + adaaX1));
        adaaX1 = x;
        adaaF1 = f;
        return y;
    }

    // ── White noise [-1, 1] (xorshift) ──
    float nextNoise()
    {
        rngState = rngState ^ (rngState << 13);
        rngState = rngState ^ (rngState >> 7);
        rngState = rngState ^ (rngState << 17);
        return float (rngState) / 9.223372e18f;
    }

    // ── Oscillator by wave type ──
    float oscSample (float phase)
    {
        if (waveType == 0)      return sin (phase * twoPi);                     // sine
        else if (waveType == 1) return 2.0f * abs (2.0f * phase - 1.0f) - 1.0f; // triangle
        else if (waveType == 2) return 2.0f * phase - 1.0f;                     // saw
        else                    return phase < 0.5f ? 1.0f : -1.0f;             // square
    }

    void advanceEnvelope (float sr)
    {
        if (envStage == 1)        // attack
        {
            envLevel += 1.0f / (max (attackS, 0.0001f) * sr);
            if (envLevel >= 1.0f) { envLevel = 1.0f; envStage = 2; }
        }
        else if (envStage == 2)   // decay
        {
            envLevel -= (1.0f - sustainLvl) / (max (decayS, 0.0001f) * sr);
            if (envLevel <= sustainLvl) { envLevel = sustainLvl; envStage = 3; }
        }
        else if (envStage == 4)   // release
        {
            envLevel -= envLevel / (max (releaseS, 0.0001f) * sr);
            if (envLevel <= 0.0001f) { envLevel = 0.0f; envStage = 0; }
        }
    }

    void main()
    {
        let sr = float (processor.frequency);

        // Oud body formants (from InstrumentProfiles.cpp).
        let f1Freq = 320.0f, f1Q = 2.5f, f1Gain = 0.45f;
        let f2Freq = 900.0f, f2Q = 3.0f, f2Gain = 0.28f;

        loop
        {
            advanceEnvelope (sr);

            if (envStage == 0)
            {
                out <- 0.0f;
                advance();
                continue;
            }

            // ── Unison oscillator stack ──
            let detuneRatio = pow (2.0f, detuneCents / 1200.0f);
            let inc0 = noteFreq / sr;
            let inc1 = (noteFreq * detuneRatio) / sr;
            let inc2 = (noteFreq / detuneRatio) / sr;

            float sig = oscSample (ph0)
                      + 0.5f * oscSample (ph1)
                      + 0.5f * oscSample (ph2);

            ph0 += inc0; if (ph0 >= 1.0f) ph0 -= 1.0f;
            ph1 += inc1; if (ph1 >= 1.0f) ph1 -= 1.0f;
            ph2 += inc2; if (ph2 >= 1.0f) ph2 -= 1.0f;

            // Sub oscillator (octave down, sine)
            if (subLevel > 0.0f)
            {
                sig += sin (phSub * twoPi) * subLevel;
                phSub += inc0 * 0.5f; if (phSub >= 1.0f) phSub -= 1.0f;
            }

            // Noise / breath
            if (noiseAmt > 0.0f)
            {
                let white = nextNoise();
                noiseLP += 0.2f * (white - noiseLP);
                sig += noiseLP * noiseAmt;
            }

            // ── ADAA waveshaper (drive) ──
            sig = adaaShape (sig * drive);

            // ── TPT state-variable lowpass ──
            let g  = tan (3.14159265f * clamp (cutoffHz, 20.0f, sr * 0.45f) / sr);
            let k  = 1.0f / max (reso, 0.0001f);
            let a1 = 1.0f / (1.0f + g * (g + k));
            let a2 = g * a1;
            let v3 = sig - svfIc2;
            let v1 = a1 * svfIc1 + a2 * v3;
            let v2 = svfIc2 + g * v1;
            svfIc1 = 2.0f * v1 - svfIc1;
            svfIc2 = 2.0f * v2 - svfIc2;
            sig = v2;   // lowpass output

            // ── Parallel formant bandpass 1 (RBJ, constant 0 dB peak) ──
            let dry = sig;

            let f1w0    = twoPi * f1Freq / sr;
            let f1alpha = sin (f1w0) / (2.0f * f1Q);
            let f1a0    = 1.0f + f1alpha;
            let band1   = (f1alpha / f1a0) * dry - (f1alpha / f1a0) * f1x2
                          + (2.0f * cos (f1w0) / f1a0) * f1y1
                          - ((1.0f - f1alpha) / f1a0) * f1y2;
            f1x2 = f1x1; f1x1 = dry;
            f1y2 = f1y1; f1y1 = band1;

            // ── Parallel formant bandpass 2 ──
            let f2w0    = twoPi * f2Freq / sr;
            let f2alpha = sin (f2w0) / (2.0f * f2Q);
            let f2a0    = 1.0f + f2alpha;
            let band2   = (f2alpha / f2a0) * dry - (f2alpha / f2a0) * f2x2
                          + (2.0f * cos (f2w0) / f2a0) * f2y1
                          - ((1.0f - f2alpha) / f2a0) * f2y2;
            f2x2 = f2x1; f2x1 = dry;
            f2y2 = f2y1; f2y1 = band2;

            sig = dry + band1 * f1Gain + band2 * f2Gain;

            // ── Amp + final cohesion clip ──
            let amp = envLevel * velocity * 0.5f;
            out <- tanh (sig * amp);

            advance();
        }
    }
}
