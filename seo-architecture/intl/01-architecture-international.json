        {
          "path": "/vst-plugins/audio-effects-plugin-architecture/",
          "slug": "audio-effects-plugin-architecture",
          "title": "Audio Effects Plugin Architecture",
          "intent": "informational-commercial",
          "keywords": ["audio effects plugin architecture", "dsp signal chain design", "real-time audio processing c++"],
