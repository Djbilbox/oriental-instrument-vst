      "schemaType": ["MusicGroup", "Product"],
      "moneyKeywords": ["professional afrotrap beats", "g-funk producer for hire", "buy oriental trap beats", "deep house producer"],
      "spokeMatrix": {
        "pattern": "{genre}-beats-{city}",
