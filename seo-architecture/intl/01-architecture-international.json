          "locale": "fr",
          "title": "Développeur Web pour Musiciens — Paris",
          "keywords": ["développeur web musique paris", "site web artiste paris", "création site label paris"]
        },
        {
          "path": "/fr/web-dev-music/developpeur-web-musique-toulouse/",
          "slug": "developpeur-web-musique-toulouse",
          "locale": "fr",
          "title": "Développeur Web pour Musiciens — Toulouse",
          "keywords": ["développeur web musique toulouse", "site web artiste toulouse", "création site studio toulouse"]
