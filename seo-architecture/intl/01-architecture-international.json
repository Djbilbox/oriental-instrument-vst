        { "path": "/beats/g-funk-beats-los-angeles/", "genre": "G-Funk", "city": "Los Angeles", "country": "US", "scene": "Talkbox, portamento synth leads, P-Funk samples" },
        { "path": "/beats/afrotrap-loops-london/", "genre": "Afrotrap", "city": "London", "country": "UK", "scene": "Afroswing, UK drill crossover, log-drum" },
        { "path": "/beats/afrotrap-beats-paris/", "genre": "Afrotrap", "city": "Paris", "country": "FR", "scene": "Afrotrap birthplace (MHD era), coupé-décalé fusion" },
