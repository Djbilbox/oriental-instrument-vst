        { "path": "/beats/uk-drill-beats-london/", "genre": "UK Drill", "city": "London", "country": "UK", "scene": "Sliding 808s, dark melodies, 140-145 BPM" }
      ]
    },

    "web-dev-music": {
      "path": "/web-dev-music/",
      "locale": "en+fr",
      "scope": "NATIONAL+INTERNATIONAL",
      "title": "Web Development for the Music Industry — Artists, Studios, Labels",
      "h1": "Web Engineering for the Music Industry",
      "schemaType": ["ProfessionalService"],
      "moneyKeywords": ["music artist website developer", "music label web developer", "artist landing page creator", "studio website developer"],
      "spokes": [
        {
          "path": "/web-dev-music/artist-landing-page-creator/",
          "slug": "artist-landing-page-creator",
