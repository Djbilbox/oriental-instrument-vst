      "schemaType": ["Product", "ProfessionalService"],
      "moneyKeywords": ["custom JUCE plugin developer", "C++ audio plugin development", "hire VST3 developer", "DSP plugin engineer for hire"],
      "spokes": [
        {
          "path": "/vst-plugins/custom-vst-plugin-creation/",
          "slug": "custom-vst-plugin-creation",
          "title": "Custom VST Plugin Creation",
          "intent": "transactional",
          "keywords": ["custom vst plugin creation", "bespoke audio plugin", "white-label vst developer"],
          "formats": ["VST3", "AU", "AAX", "CLAP"]
        },
        {
          "path": "/vst-plugins/juce-cpp-developer/",
          "slug": "juce-cpp-developer",
          "title": "JUCE C++ Developer for Hire",
          "intent": "transactional",
          "keywords": ["juce c++ developer", "juce framework expert", "hire juce developer", "freelance audio programmer"],
          "isHeroPage": true
