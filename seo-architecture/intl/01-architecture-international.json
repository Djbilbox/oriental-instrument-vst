{
  "$schema": "djbilbox-programmatic-seo/v2",
  "site": {
    "brand": "DJBILBOX BEATS",
    "domain": "https://djbilboxbeats.com",
    "defaultLocale": "en",
    "locales": {
      "en": { "market": "Global (US/UK/EU/MENA)", "role": "primary-money-keywords" },
      "fr": { "market": "France hubs (Paris/Toulouse)", "role": "local-authority" }
    },
    "hreflang": { "x-default": "en", "en": "/", "fr": "/fr/" },
    "strategy": "hub-and-spoke semantic silo, raw HTML5, target 100/100 PageSpeed, mass-index niche money pages"
  },

  "hubs": {

    "vst-plugins": {
      "path": "/vst-plugins/",
      "locale": "en",
      "scope": "WORLDWIDE",
      "title": "Custom VST Plugin Development — C++ / JUCE Audio Engineer",
