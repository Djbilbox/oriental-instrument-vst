  "internalLinking": {
    "breadcrumb": ["root", "hub", "spoke"],
    "siloRule": "spokes link UP to own hub + SIDEWAYS to 2 sibling spokes; hubs cross-link once to each other hub (vst-plugins <-> beats <-> web-dev-music)",
    "anchorStrategy": "exact-match for money keyword, partial-match for support links, branded for cross-hub",
    "maxOutboundPerPage": 8
  },

  "scaling": {
    "generationTarget": "300+ pages indexed in 24h",
    "method": "static-gen: JSON x template x injection-variables -> flat .html files",
    "sitemap": "auto-split sitemap_index.xml (1 per hub) + hreflang annotations",
    "indexing": "IndexNow API ping (Bing) + GSC sitemap submit + internal-link graph for discovery"
  }
}
