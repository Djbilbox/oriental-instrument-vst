        {
          "path": "/vst-plugins/dsp-optimization-service/",
          "slug": "dsp-optimization-service",
          "title": "DSP Optimization & Audit Service",
          "intent": "transactional",
          "keywords": ["dsp optimization service", "audio plugin cpu optimization", "juce performance audit"]
        }
      ]
    },

    "beats": {
      "path": "/beats/",
      "locale": "en",
      "scope": "WORLDWIDE",
      "title": "Professional Beats — Hip-Hop, Afrotrap, Deep House, G-Funk, Oriental",
