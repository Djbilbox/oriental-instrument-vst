<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Info -->
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>com.djbilbox.orientalinstrument.ios</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Oriental Instrument</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1.0.0</string>

    <!-- Minimum iOS version -->
    <key>MinimumOSVersion</key>
    <string>13.0</string>

    <!-- Supported device orientations -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Audio background modes -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>

    <!-- Required capabilities -->
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>microphone</string>
    </array>

    <!-- SKStoreProductParameterITunesItemIdentifier for IAP -->
    <key>SKStoreProductParameterITunesItemIdentifier</key>
    <string>PLACEHOLDER_APP_ID</string>

    <!-- Privacy descriptions -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Oriental Instrument needs microphone access for audio input and monitoring.</string>

</dict>
</plist>
